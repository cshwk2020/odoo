<odoo>
    <record id="view_expense_form_autofill" model="ir.ui.view">
        <field name="name">hr.expense.form.autofill</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <group string="Autofill Information" name="autofill_info" col="2">

                    <field name="autofill_job_state" widget="statusbar"/>
                    <field name="autofill_in_progress" widget="toggle_button"/>

                </group>
            </xpath>

            <xpath expr="//header" position="inside">

                <button name="action_cancel_autofill"
                        type="object"
                        string="Cancel"
                        class="btn-danger"
                        invisible="autofill_in_progress == False"/>
            </xpath>
        </field>
    </record>
</odoo>