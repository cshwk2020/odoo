<odoo>
    <record id="view_receipt_upload_wizard" model="ir.ui.view">
        <field name="name">receipt.upload.wizard.form</field>
        <field name="model">receipt.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Receipt for Autofill">
                <group>
                    <field name="receipt_image"
                           widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'receipt_image'}"
                           placeholder="Click to select receipt image"
                           required="1"/>
                    <field name="expense_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_upload_and_autofill"
                            string="Upload &amp; Auto Fill"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>