<odoo>

    <record id="view_estate_property_qweb" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id"
                    group_create="false"
                    group_delete="false"
                    group_draggable="false"
                    show_count="false"
                    draggable="false">

                <!--
                only for fields need raw_value, eg, record.state.raw_value
                -->
                <field name="state"/>

                <templates>

                    <t t-name="card">
                        <div><field name="name"/></div>

                        <!-- Expected price always shown -->
                        <div>
                            Expected Price: <field name="expected_price"/>
                        </div>

                        <!-- Best price only if an offer is received -->
                        <div t-if="record.state.raw_value == 'offer_received'">
                            Best Price: <field name="best_price"/>
                        </div>

                        <!-- Selling price only if offer accepted -->
                        <div t-if="record.state.raw_value == 'offer_accepted'">
                            Selling Price: <field name="selling_price"/>
                        </div>

                        <!-- Tags -->
                        <div><field name="tag_ids"/></div>

                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_property_qweb" model="ir.actions.act_window">
        <field name="name">qweb</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_estate_property_qweb"/>
    </record>

    <!-- Menu -->
    <menuitem id="qweb_estate_menu_root" name="Estate"/>
    <menuitem id="qweb_estate_menu_property" name="Properties (QWeb)"
              parent="estate_menu_root" action="action_property_qweb"/>

    <menuitem id="qweb_estate_menu_property"
              name="QWeb"
              parent="estate_menu_root"
              action="action_property_qweb"
              sequence="20"/>

</odoo>
