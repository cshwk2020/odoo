<odoo>


    <!-- Search view -->
    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Properties">
                <!-- Search fields -->
                <field name="property_type_id"/>

                <field name="name"/>
                <field name="postcode"/>



                <!-- Filters -->
                <field name="living_area"
                       string="Living Area"
                       filter_domain="[('living_area', '>=', self)]"/>


                <filter name="available_properties"
                        domain="[('state','=','new')]"
                        string="Available"/>
                <filter name="sold_properties"
                        domain="[('state','=','sold')]"
                        string="Sold"/>

                <!-- Group By -->
                <group>

                    <filter name="group_by_postcode"
                            context="{'group_by':'postcode'}"
                            string="Group by Postcode"/>
                </group>
                <group>
                    <filter name="group_by_type"
                            context="{'group_by':'property_type_id'}"
                            string="Group by Type"/>
                </group>
            </search>
        </field>
    </record>



    <!-- List view -->
    <record id="view_estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban string="Properties"
                    decoration-success="state in ('offer_received','offer_accepted')"
                    decoration-muted="state == 'sold'"
                    decoration-bf="state == 'offer_accepted'">

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">

                            <strong><field name="property_type_id"/></strong><br/>

                            <strong><field name="name"/></strong><br/>
                            <span><field name="postcode"/></span><br/>
                            <span>Bedrooms: <field name="bedrooms"/></span><br/>
                            <span>Living Area: <field name="living_area"/></span><br/>

                            <span>Expected: <field name="expected_price"/></span><br/>
                            <span>Selling: <field name="selling_price"/></span><br/>
                            <span>Available: <field name="date_availability" /></span><br/>
                            <span>Status: <field name="state" widget="statusbar"/></span>

                            <field name="salesperson_id" />
                            <field name="tag_ids" />


                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>



    <!-- Form view -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>

                    <field name="state" widget="statusbar"
                           options="{'clickable': true}"
                           statusbar_visible="new,offer_received,offer_accepted,sold,cancelled"/>

                    <button name="action_cancel" type="object" string="Cancel" class="btn btn-secondary"
                            invisible="state == 'cancelled'" />

                    <button name="action_sold" type="object" string="Sold" class="btn btn-primary"
                            invisible="state == 'sold' or state == 'cancelled'" />

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h1>

                            <field name="property_type_id"
                                   options="{'no_create': True, 'no_open': True}"/>

                        </h1>

                    </div>

                    <group>
                        <group>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="state" />
                            <field name="salesperson_id" />

                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_area" invisible="garden == False"/>
                                    <field name="garden_orientation" invisible="garden == False"/>
                                </group>
                            </group>
                        </page>
                        <page string="Details">
                            <group>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <field name="partner_id"/>
                            </group>
                        </page>

                        <page string="Areas">
                            <group>
                                <field name="living_area"/>
                                <field name="garden_area"/>
                                <field name="total_area" readonly="1"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>



    <!-- views/estate_property_views.xml -->
    <record id="view_estate_property_form_inherit_offers" model="ir.ui.view">
        <field name="name">estate.property.form.inherit.offers</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate.view_estate_property_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <notebook>
                    <page string="Offers">
                        <field name="offer_ids" readonly="state in ('offer_accepted','sold','cancelled')">
                            <list editable="bottom" >
                                <field name="price"/>
                                <field name="partner_id"/>
                                <field name="status"/>
                            </list>
                        </field>
                        <group>
                        <field  name="best_price" readonly="1"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>





    <!-- Action -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_estate_property_kanban"/>
        <field name="search_view_id" ref="estate_property_search_view"/>

        <!-- Context defines default filters, eval run it -->
        <field name="context" eval="{'search_default_available_properties': 1}"/>
    </record>


    <!-- Menu -->
    <menuitem id="estate_menu_root" name="Estate"/>
    <menuitem id="estate_menu_property" name="Properties"
              parent="estate_menu_root" action="estate_property_action"/>


</odoo>
